# Copy to backend/.env and fill in. .env is git-ignored; never commit real secrets.

# CORS: comma-separated origins allowed to call the API (the Vite dev server).
AEGIS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Feature flags ------------------------------------------------------------
# Recycled context. "local" matches the image by content against the offline image history
# index (default; "index" and "cache" are older names for it). "live" also searches the web for
# every image upload with Google Cloud Vision (needs GOOGLE_VISION_API_KEY below); with the key
# set, users can also tick "search the web" for a single upload. Videos use the local index only.
AEGIS_REVERSE_IMAGE_MODE=local
# Where live results are cached by image SHA-256 (empty => data/live_cache/, git-ignored).
# AEGIS_LIVE_CACHE_DIR=
# Optional override for the index path; empty => backend/app/data/image_history_index.json.
# AEGIS_IMAGE_INDEX_PATH=
# pHash match threshold, in bits out of 64 (PROVISIONAL), and whether to also match mirror images.
AEGIS_PHASH_MATCH_THRESHOLD=10
AEGIS_PHASH_MIRROR_LOOKUP=true
# Second stage when the hash finds nothing: keypoint matching (ORB + RANSAC). Finds cropped,
# bordered and screenshot-framed copies. Minimum agreeing keypoint pairs is PROVISIONAL.
AEGIS_KEYPOINT_MATCHING=true
AEGIS_KEYPOINT_MIN_INLIERS=12
# Caption vs picture. "image" (default) compares the picture with the caption using CLIP.
# "meaning" adds spaCy similarity between the caption and the scene description. "overlap" is the
# earlier word-overlap rule. "off" skips the check and the scorecard says so. Models must already
# be on disk; they are never downloaded at run time, and only the chosen method's are loaded.
AEGIS_CAPTION_MATCH_METHOD=image
# Use the local Ollama LLM reasoner. If false, fusion runs rules-only.
AEGIS_USE_LLM=false

# Local LLM reasoner (Ollama) ---------------------------------------------
# Ollama endpoint when AEGIS_USE_LLM=true.
AEGIS_OLLAMA_HOST=http://localhost:11434
AEGIS_OLLAMA_MODEL=phi3:mini

# Live reverse-image lookup: the Google Cloud Vision key. Set it in the environment, never in a
# file in the repository. Live lookups stop at 900 a month (counted in data/live_cache/usage.json).
# GOOGLE_VISION_API_KEY=
