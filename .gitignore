# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/

# ---- Environment / secrets ----
.env
.env.*
!.env.example
*.key

# ---- Node / frontend ----
node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*

# ---- Models / large artefacts (never commit weights) ----
*.gguf
*.bin
*.safetensors
*.pt
*.onnx
models_cache/
.cache/

# ---- OS / editor ----
.DS_Store
Thumbs.db
.idea/
.vscode/

# ---- Aegis runtime ----
backend/.cache/
backend/scripts/_*.json
# Eval test-set images are tiny blank placeholders regenerated by run_eval.py; the manifest
# (examples.json) is the real committed ground truth. Don't commit the generated blanks.
backend/tests/eval/test_set/images/
uploads/
*.log
backend/_m.txt

# Personal and third-party test images: keep them in local_media/, which is never published.
local_media/
*-test.jpeg

# Demo/test images (personal media, not redistributed)
beach.jpeg
at-my-park.jpeg
flood_recycled_2019.jpg

# --- Data, media and secrets that must never be public ---
# Raw and third-party datasets: IDs and labels live in data/labels/, never the media itself.
data/raw/
data/verite/
data/A_originals/
data/E_videos/
data/E_speech/
data/F_captions/
# Live web lookups of uploads, and the monthly call count: local only.
data/live_cache/
data/**/images/
data/**/video/
# Environment files (only *.env.example is tracked).
.env
*.env
!*.env.example
# Large media produced or collected locally (demo recordings, clips, captures).
*.mp4
*.mov
*.webm
*.mkv
*.wav
*.m4a
# Working artefacts that are not source.
Demo Posts/
# Local documents (plan, interface review, screenshots): kept on this laptop, not published.
/docs/
# Evaluation output. Ignored until the release step commits the frozen final results.
/results/
# Submitted reports and the colour-coded draft. Matched by pattern,
# never by a filename that carries personal data. (A broad *.html rule would catch
# frontend/index.html, so the draft is named.)
AEGIS - *.pdf
Aegis Colour-coded.html

# --- Never in git history, by rule (2026-09-27): every note, plan, log and ADR stays local ---
# Markdown of any kind: README, DEVLOG, DECISIONS/ADRs, plans, folder READMEs.
*.md
*.MD
*.markdown
# Dev logs in any format.
DEV_LOG*
DEVLOG*
dev_log*
devlog*
# Course material (University of London): kept on this laptop only.
Resources/Instructions/
Resources/Transcripts/
