# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/

# ---- Environment / secrets ----
.env
.env.*
!.env.example
*.key

# ---- Node / frontend ----
node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*

# ---- Models / large artefacts (never commit weights) ----
*.gguf
*.bin
*.safetensors
*.pt
*.onnx
models_cache/
.cache/

# ---- OS / editor ----
.DS_Store
Thumbs.db
.idea/
.vscode/

# ---- Aegis runtime ----
backend/.cache/
backend/scripts/_*.json
# Eval test-set images are blank placeholders that run_eval.py regenerates; the labels are in
# the committed examples.json.
backend/tests/eval/test_set/images/
uploads/
*.log
backend/_m.txt

# Personal and third-party test images: keep them in local_media/, which is never published.
local_media/
*-test.jpeg

# Demo/test images (personal media, not redistributed)
beach.jpeg
at-my-park.jpeg
flood_recycled_2019.jpg

# --- Data, media and secrets that stay private ---
# Raw and third-party datasets: IDs and labels live in data/labels/, never the media itself.
data/raw/
data/verite/
data/A_originals/
data/E_videos/
data/E_speech/
data/F_captions/
# Live web lookups of uploads, and the monthly call count: local only.
data/live_cache/
data/**/images/
data/**/video/
# Environment files (only *.env.example is tracked).
.env
*.env
!*.env.example
# Large media produced or collected locally (demo recordings, clips, captures).
*.mp4
*.mov
*.webm
*.mkv
*.wav
*.m4a
# Working artefacts that are not source.
Demo Posts/
# Local documents (plan, interface review, screenshots): kept on this laptop, not published.
/docs/
# Evaluation output from backend/scripts/run_final_eval.py (not in the repository). The records
# of earlier runs that it reads are in data/earlier_runs/.
/results/
# Submitted reports and the colour-coded draft, matched by pattern rather than a filename with
# personal data. (A *.html rule would also catch frontend/index.html, so the draft is named.)
AEGIS - *.pdf
Aegis Colour-coded.html

# --- Notes, plans, logs and decision records stay local, never in git (since 2026-09-27) ---
# Markdown of any kind (READMEs, dev logs, decision records, plans).
*.md
*.MD
*.markdown
# Dev logs in any format.
DEV_LOG*
DEVLOG*
dev_log*
devlog*
# Course material (University of London): kept on this laptop only.
Resources/Instructions/
Resources/Transcripts/

# Keypoints of the image history index, computed from the local images and stored next to it
backend/app/data/*.keypoints.npz
backend/app/data/*.keypoints.npz.tmp
# Fresh hard cases for image matching (NASA photos, downloaded by get_hard_pairs.py)
data/hard_pairs/
# The final evaluation's cache of slow model outputs and the outputs its audits read. Rebuilt by
# run_final_eval.py --rebuild; they hold dataset text that is not ours to publish.
data/final_eval_cache/
data/final_eval_outputs/
