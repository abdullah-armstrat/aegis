backend/.cache/
backend/scripts/_*.json
# Eval test-set images are tiny blank placeholders regenerated by run_eval.py; the manifest
# (examples.json) is the real committed ground truth. Don't commit the generated blanks.
backend/tests/eval/test_set/images/
uploads/
*.log
backend/_m.txt

# Personal/test media (not redistributed - ethics)
fbr-test.jpeg
*-test.jpeg
[name]-test.jpeg

# Demo/test images (personal media, not redistributed)
beach.jpeg
at-my-park.jpeg
flood_recycled_2019.jpg

# --- Final phase (WP-0): data, media and secrets that must never be public ---
# Raw and third-party datasets: IDs and labels live in data/labels/, never the media itself.
data/raw/
data/verite/
data/**/images/
data/**/video/
# Environment files (only *.env.example is tracked).
.env
*.env
!*.env.example
# Large media produced or collected locally (demo recordings, clips, captures).
*.mp4
*.mov
*.webm
*.mkv
*.wav
*.m4a
# Working artefacts that are not source.
Demo Posts/
docs/results/
# Submitted report and its colour-coded draft (by name: a broad
# *.pdf / *.html rule would also catch tracked course material and frontend/index.html).
AEGIS - Ahmad Abdullah Qureshi - [student number].pdf
Aegis Colour-coded.html
