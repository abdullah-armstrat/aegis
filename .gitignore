# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/

# ---- Environment / secrets ----
.env
.env.*
!.env.example
*.key

# ---- Node / frontend ----
node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*

# ---- Models / large artefacts (never commit weights) ----
*.gguf
*.bin
*.safetensors
*.pt
*.onnx
models_cache/
.cache/

# ---- OS / editor ----
.DS_Store
Thumbs.db
.idea/
.vscode/

# ---- Aegis runtime ----
backend/.cache/
backend/scripts/_*.json
# Eval test-set images are tiny blank placeholders regenerated by run_eval.py; the manifest
# (examples.json) is the real committed ground truth. Don't commit the generated blanks.
backend/tests/eval/test_set/images/
uploads/
*.log
backend/_m.txt

# Personal/test media (not redistributed - ethics)
fbr-test.jpeg
*-test.jpeg
[name]-test.jpeg
